# VATSIM Connect OAuth
VATSIM_CLIENT_ID=
VATSIM_CLIENT_SECRET=

# VATUSA API
VATUSA_API_KEY=

# Session signing secret - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to 'production' on the live server; enables secure cookies and disables dev-login
NODE_ENV=development

# The frontend's URL, for CORS
FRONTEND_URL=http://localhost:5173
FRONTEND_REDIRECT_URI=http://localhost:5173/

# Port the server listens on (most hosts set this automatically)
PORT=4000

# Number of reverse proxy hops in front of this server (e.g. 1 if there's a single load
# balancer/ingress, 0 if this server is reachable directly). Controls how much the rate
# limiter trusts X-Forwarded-For for the caller's real IP - get this wrong in either
# direction and either every client behind your own proxy shares one bucket, or a client
# can spoof this header to reset their own limit. Defaults to 0 (trust nothing) if unset.
TRUST_PROXY_HOPS=0