# VATSIM Connect OAuth
VATSIM_CLIENT_ID=
VATSIM_CLIENT_SECRET=

# VATUSA API
VATUSA_API_KEY=

# Session signing secret - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to 'production' on the live server; enables secure cookies and disables dev-login
NODE_ENV=development

# The frontend's URL, for CORS
FRONTEND_URL=http://localhost:5173
FRONTEND_REDIRECT_URI=http://localhost:5173/

# Port the server listens on (most hosts set this automatically)
PORT=4000