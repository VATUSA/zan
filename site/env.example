# Backend API URL
#
# For local `npm run dev`, these are read by Vite from this .env file at build time as
# usual. In the Docker image they are instead read at container startup from real
# environment variables of the same name (see docker-entrypoint.d/40-env-config.sh) - set
# them in the deployment's ConfigMap/Secret, not as a Docker build-arg.
VITE_API_URL=http://localhost:4000

# VATSIM Connect - sandbox (auth-dev) for local dev, auth.vatsim.net once approved for prod
VITE_VATSIM_AUTH_URL=https://auth-dev.vatsim.net/oauth/authorize
VITE_VATSIM_CLIENT_ID=

# Optional - defaults to this site's own origin + "/" if unset, which is correct for most
# setups. Only set this if the site is served from a different origin than where VATSIM
# should redirect back to.
# Whatever this resolves to MUST exactly match the API's FRONTEND_REDIRECT_URI (api/.env) -
# VATSIM's token exchange rejects a mismatched redirect_uri.
VITE_VATSIM_REDIRECT_URI=